# Discord OAuth (Developer Portal - same app as the bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://calendar.rated16bit.uk/api/auth/callback

# Supabase (same project the bot uses)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Any random long string - used to sign the login cookie
SESSION_SECRET=

# Same server ID the bot uses
DISCORD_GUILD_ID=

# Role IDs (Server Settings -> Roles -> right-click -> Copy Role ID, Developer Mode on)
# Core = your 5 who can join/leave days. Admin = can set games/capacity/approve guests.
DISCORD_CORE_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=

# Webhook that posts to #calendar when someone requests to guest (Channel Settings -> Integrations
# -> Webhooks -> New Webhook -> Copy Webhook URL). Optional - skip it and requests just won't alert anyone.
DISCORD_GUEST_REQUEST_WEBHOOK_URL=
