# Discord (Step 2)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ROLE_NAME=Stream Lead

# Supabase (Step 1)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Social automation (all optional; each feature switches off if its settings are blank) ---

# Twitch (dev.twitch.tv -> Your Console -> Register Your Application; any redirect URL, e.g. http://localhost)
# Used to spot when the channel goes live and offline. No Twitch login needed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=tntnerds

# Discord channel for going live and weekly schedule posts (leave blank to skip Discord posts)
DISCORD_ANNOUNCE_CHANNEL_ID=

# Postiz (Settings -> Developers -> Public API)
# Cloud: https://api.postiz.com/public/v1   Self-hosted: https://<your postiz backend>/public/v1
POSTIZ_API_URL=
POSTIZ_API_KEY=
# Channel IDs, comma separated. Run `npm run postiz-channels` to list them.
POSTIZ_LIVE_CHANNELS=
POSTIZ_WEEKLY_CHANNELS=
# Page the "Open Postiz" button in the reminder DM goes to
POSTIZ_APP_URL=https://platform.postiz.com/launches

# After stream reminder DM (your Discord user ID: Settings -> Advanced -> Developer Mode, then right click yourself -> Copy User ID)
REMINDER_DISCORD_USER_ID=
# mine = only after streams you are on the roster for; all = after every stream
REMINDER_MODE=mine

# Weekly schedule post, UK time. Day: 0 = Sunday ... 6 = Saturday
WEEKLY_POST_DAY=0
WEEKLY_POST_TIME=18:00
# When the socials version goes out (the Monday of the new week)
WEEKLY_PUBLISH_TIME=09:00
